---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import CategoryTabs from '../../../components/CategoryTabs.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../../consts';

// 글이 있는 분류만 페이지를 만든다. 빈 분류로 들어오면 404 가 나는 편이
// 빈 목록을 보여 주는 것보다 낫다.
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORIES.filter((c) => posts.some((p) => p.data.category === c)).map(
		(category) => ({
			params: { category },
			props: {
				posts: posts
					.filter((p) => p.data.category === category)
					.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
			},
		}),
	);
}

const { category } = Astro.params;
const { posts } = Astro.props;

const all = await getCollection('blog');
const used = CATEGORIES.filter((c) => all.some((p) => p.data.category === c));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${category} — ${SITE_TITLE}`}
			description={`${category} 분류의 글 ${posts.length}편`}
		/>
		<style>
			main {
				width: 760px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				padding: 1.6rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li:last-child {
				border-bottom: none;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0.8rem;
				border-radius: 10px;
			}
			.title {
				margin: 0;
				font-size: 1.28rem;
				line-height: 1.45;
				color: rgb(var(--black));
				word-break: keep-all;
			}
			.date {
				margin: 0.35rem 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.desc {
				margin: 0.6rem 0 0;
				font-size: 0.94rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
			}
			ul li a:hover .title {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				.title {
					font-size: 1.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<CategoryTabs categories={used} current={category} />
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="desc">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
