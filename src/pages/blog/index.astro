---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 글이 하나도 없는 분류는 탭에 띄우지 않는다. 눌렀더니 빈 화면이 나오는
// 것보다 아예 안 보이는 편이 낫다.
const used = CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 760px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			/* 2단 배치는 한글 제목이 줄바꿈되며 답답해진다. 한 줄에 하나씩 두고 요약을 보인다. */
			ul li {
				padding: 1.6rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li:last-child {
				border-bottom: none;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0.8rem;
				border-radius: 10px;
			}
			.title {
				margin: 0;
				font-size: 1.28rem;
				line-height: 1.45;
				color: rgb(var(--black));
				word-break: keep-all;
			}
			.date {
				margin: 0.35rem 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			/* 날짜 줄에 함께 두어 제목 아래 한 줄로 정리한다 */
			.cat {
				margin-left: 0.5rem;
				padding: 0.1rem 0.5rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				font-size: 0.78rem;
				color: rgb(var(--gray-dark));
			}
			.desc {
				margin: 0.6rem 0 0;
				font-size: 0.94rem;
				line-height: 1.7;
				color: rgb(var(--gray-dark));
			}
			ul li a:hover .title {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.title {
					font-size: 1.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<CategoryTabs categories={used} />
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
										<span class="cat">{post.data.category}</span>
									</p>
									<p class="desc">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
