---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// 최근 글을 홈에 노출한다. 첫 화면에서 바로 읽을거리가 보이는 편이 낫다.
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recent = posts.slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="lead">{SITE_DESCRIPTION}</p>
			<p>
				<strong>개발</strong> — 검색해도 잘 안 나오던 것, 로그만 봐서는 원인이 드러나지 않던 것
				위주로 씁니다. 백엔드(Python·FastAPI), 프론트엔드(React), 배포·인프라(Docker)를 주로 다룹니다.
			</p>
			<p>
				<strong>투자</strong> — 매주 주식 일정을 정리합니다. 공모주 청약·배당기준일·유상증자처럼
				날짜가 정해진 것만 금융감독원 전자공시(DART) 원문에서 모으고, 종목 추천은 하지 않습니다.
			</p>

			<h2>최근 글</h2>
			<ul class="recent">
				{
					recent.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3 class="title">{post.data.title}</h3>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
									<span class="cat">{post.data.category}</span>
								</p>
								<p class="desc">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>
			<p><a href="/blog/">글 전체 보기 →</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 3em 1em;
	}
	h1 {
		margin-bottom: 0.2em;
	}
	.lead {
		color: rgb(var(--gray));
		margin-top: 0;
	}
	h2 {
		margin-top: 2.5em;
		font-size: 1.3em;
	}
	/* 아래 값은 목록 화면(/blog/)과 같다. 같은 글 목록이 두 화면에서 달라 보이면
	   손이 덜 간 쪽이 대충 만든 것처럼 읽힌다. 한쪽만 고치지 말 것. */
	.recent {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.recent li {
		padding: 1.6rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.recent li:last-child {
		border-bottom: none;
	}
	.recent li a {
		display: block;
		text-decoration: none;
	}
	.title {
		margin: 0;
		font-size: 1.28rem;
		line-height: 1.45;
		color: rgb(var(--black));
		word-break: keep-all;
	}
	.date {
		margin: 0.35rem 0 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	/* 분류 배지. 개발·투자가 섞여 나오므로 제목을 읽지 않아도 구분돼야 한다. */
	.cat {
		margin-left: 0.5rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		font-size: 0.78rem;
		color: rgb(var(--gray-dark));
	}
	.desc {
		margin: 0.4rem 0 0;
		color: rgb(var(--gray-dark));
		word-break: keep-all;
	}
</style>
